{
  "name": "Passerelle GPX",
  "short_name": "GPX → Strava",
  "description": "Publie un fichier GPX exporté de Samsung Health directement sur Strava.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1d2622",
  "theme_color": "#1d2622",
  "lang": "fr",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "gpx",
          "accept": [".gpx", "application/gpx+xml", "application/gpx", "application/xml", "text/xml", "application/octet-stream", "*/*"]
        }
      ]
    }
  }
}
